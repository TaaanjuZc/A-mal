# Copy this file to .env.local and fill in the values from the Supabase
# project "daily tracker" (Project Settings → API). Use the anon public key,
# never the service_role key. Restart the dev server after saving.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key
